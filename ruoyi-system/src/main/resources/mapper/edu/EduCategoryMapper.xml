<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduCategoryMapper">

    <resultMap type="EduCategory" id="EduCategoryResult">
        <result property="categoryId" column="category_id"/>
        <result property="parentId" column="parent_id"/>
        <result property="ancestors" column="ancestors"/>
        <result property="categoryName" column="category_name"/>
        <result property="orderNum" column="order_num"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="parentName" column="parent_name"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectCategoryVo">
        select c.category_id, c.parent_id, c.ancestors, c.category_name, c.order_num, c.status, c.del_flag,
               c.remark, c.create_by, c.create_time, c.update_by, c.update_time,
               p.category_name as parent_name
        from edu_category c
        left join edu_category p on p.category_id = c.parent_id
    </sql>

    <select id="selectCategoryList" parameterType="EduCategory" resultMap="EduCategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            c.del_flag = '0'
            <if test="categoryName != null and categoryName != ''">
                and c.category_name like concat('%', #{categoryName}, '%')
            </if>
            <if test="status != null and status != ''">
                and c.status = #{status}
            </if>
        </where>
        order by c.order_num asc, c.category_id asc
    </select>

    <select id="selectCategoryById" parameterType="Long" resultMap="EduCategoryResult">
        <include refid="selectCategoryVo"/>
        where c.category_id = #{categoryId}
          and c.del_flag = '0'
    </select>

    <select id="checkCategoryNameUnique" parameterType="EduCategory" resultMap="EduCategoryResult">
        <include refid="selectCategoryVo"/>
        where c.parent_id = #{parentId}
          and c.category_name = #{categoryName}
          and c.del_flag = '0'
        limit 1
    </select>

    <select id="selectChildrenCategoryById" parameterType="Long" resultMap="EduCategoryResult">
        <include refid="selectCategoryVo"/>
        where find_in_set(#{categoryId}, c.ancestors)
          and c.del_flag = '0'
        order by c.ancestors, c.order_num
    </select>

    <select id="selectNormalChildrenCategoryById" parameterType="Long" resultType="int">
        select count(1)
        from edu_category
        where find_in_set(#{categoryId}, ancestors)
          and status = '0'
          and del_flag = '0'
    </select>

    <select id="hasChildByCategoryId" parameterType="Long" resultType="int">
        select count(1)
        from edu_category
        where parent_id = #{categoryId}
          and del_flag = '0'
    </select>

    <insert id="insertCategory" parameterType="EduCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into edu_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null">ancestors,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null">#{ancestors},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateCategory" parameterType="EduCategory">
        update edu_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null">ancestors = #{ancestors},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where category_id = #{categoryId}
    </update>

    <update id="updateCategoryChildren">
        <foreach collection="list" item="item" separator=";">
            update edu_category
            set ancestors = #{item.ancestors}
            where category_id = #{item.categoryId}
        </foreach>
    </update>

    <update id="deleteCategoryById" parameterType="Long">
        update edu_category
        set del_flag = '2'
        where category_id = #{categoryId}
    </update>

</mapper>
