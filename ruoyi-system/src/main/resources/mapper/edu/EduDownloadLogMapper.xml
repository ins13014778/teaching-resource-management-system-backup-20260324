<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduDownloadLogMapper">
    <resultMap type="EduDownloadLog" id="EduDownloadLogResult">
        <result property="logId" column="log_id"/>
        <result property="resourceId" column="resource_id"/>
        <result property="resourceTitle" column="resource_title"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="fileUrl" column="file_url"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectDownloadLogVo">
        select log_id, resource_id, resource_title, user_id, user_name, file_url, create_by, create_time, remark from edu_download_log
    </sql>

    <select id="selectDownloadLogList" parameterType="EduDownloadLog" resultMap="EduDownloadLogResult">
        <include refid="selectDownloadLogVo"/>
        <where>
            1 = 1
            <if test="resourceTitle != null and resourceTitle != ''">and resource_title like concat('%', #{resourceTitle}, '%')</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
            <if test="userId != null">and user_id = #{userId}</if>
        </where>
        order by log_id desc
    </select>

    <insert id="insertDownloadLog" parameterType="EduDownloadLog" useGeneratedKeys="true" keyProperty="logId">
        insert into edu_download_log(resource_id, resource_title, user_id, user_name, file_url, create_by, create_time, remark)
        values(#{resourceId}, #{resourceTitle}, #{userId}, #{userName}, #{fileUrl}, #{createBy}, sysdate(), #{remark})
    </insert>

    <delete id="deleteDownloadLogByIds">
        delete from edu_download_log where log_id in
        <foreach collection="array" item="logId" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
</mapper>
