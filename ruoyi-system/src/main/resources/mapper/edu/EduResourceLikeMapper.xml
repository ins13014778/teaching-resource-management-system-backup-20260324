<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduResourceLikeMapper">
    <resultMap type="EduResourceLike" id="EduResourceLikeResult">
        <result property="likeId" column="like_id"/>
        <result property="resourceId" column="resource_id"/>
        <result property="resourceTitle" column="resource_title"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="remark" column="remark"/>
    </resultMap>
    <sql id="selectLikeVo">select like_id, resource_id, resource_title, user_id, user_name, create_by, create_time, remark from edu_resource_like</sql>
    <select id="selectLikeList" parameterType="EduResourceLike" resultMap="EduResourceLikeResult">
        <include refid="selectLikeVo"/>
        <where>
            <if test="resourceTitle != null and resourceTitle != ''">and resource_title like concat('%', #{resourceTitle}, '%')</if>
            <if test="resourceId != null">and resource_id = #{resourceId}</if>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="userName != null and userName != ''">and user_name like concat('%', #{userName}, '%')</if>
        </where>
        order by like_id desc
    </select>
    <select id="selectLikeById" parameterType="Long" resultMap="EduResourceLikeResult"><include refid="selectLikeVo"/> where like_id = #{likeId}</select>
    <select id="selectByUserIdAndResourceId" resultMap="EduResourceLikeResult"> <include refid="selectLikeVo"/> where user_id = #{param1} and resource_id = #{param2} limit 1 </select>
    <insert id="insertLike" parameterType="EduResourceLike" useGeneratedKeys="true" keyProperty="likeId">
        insert into edu_resource_like(resource_id, resource_title, user_id, user_name, create_by, create_time, remark)
        values(#{resourceId}, #{resourceTitle}, #{userId}, #{userName}, #{createBy}, sysdate(), #{remark})
    </insert>
    <delete id="deleteLikeByIds">
        delete from edu_resource_like where like_id in
        <foreach collection="array" item="likeId" open="(" separator="," close=")">#{likeId}</foreach>
    </delete>
    <delete id="deleteById">delete from edu_resource_like where like_id = #{likeId}</delete>
</mapper>
