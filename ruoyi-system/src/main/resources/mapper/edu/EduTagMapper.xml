<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.EduTagMapper">

    <resultMap type="EduTag" id="EduTagResult">
        <result property="tagId" column="tag_id"/>
        <result property="tagName" column="tag_name"/>
        <result property="tagType" column="tag_type"/>
        <result property="color" column="color"/>
        <result property="status" column="status"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectTagVo">
        select tag_id, tag_name, tag_type, color, status, del_flag, remark,
               create_by, create_time, update_by, update_time
        from edu_tag
    </sql>

    <select id="selectTagList" parameterType="EduTag" resultMap="EduTagResult">
        <include refid="selectTagVo"/>
        <where>
            del_flag = '0'
            <if test="tagName != null and tagName != ''">
                and tag_name like concat('%', #{tagName}, '%')
            </if>
            <if test="tagType != null and tagType != ''">
                and tag_type = #{tagType}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by tag_id desc
    </select>

    <select id="selectEnabledTagList" resultMap="EduTagResult">
        <include refid="selectTagVo"/>
        where del_flag = '0'
          and status = '0'
        order by tag_id desc
    </select>

    <select id="selectTagById" parameterType="Long" resultMap="EduTagResult">
        <include refid="selectTagVo"/>
        where tag_id = #{tagId}
          and del_flag = '0'
    </select>

    <select id="checkTagNameUnique" parameterType="String" resultMap="EduTagResult">
        <include refid="selectTagVo"/>
        where tag_name = #{tagName}
          and del_flag = '0'
        limit 1
    </select>

    <insert id="insertTag" parameterType="EduTag" useGeneratedKeys="true" keyProperty="tagId">
        insert into edu_tag(tag_name, tag_type, color, status, remark, create_by, create_time)
        values(#{tagName}, #{tagType}, #{color}, #{status}, #{remark}, #{createBy}, sysdate())
    </insert>

    <update id="updateTag" parameterType="EduTag">
        update edu_tag
        set tag_name = #{tagName},
            tag_type = #{tagType},
            color = #{color},
            status = #{status},
            remark = #{remark},
            update_by = #{updateBy},
            update_time = sysdate()
        where tag_id = #{tagId}
    </update>

    <update id="deleteTagByIds">
        update edu_tag
        set del_flag = '2'
        where tag_id in
        <foreach collection="array" item="tagId" open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </update>

</mapper>
